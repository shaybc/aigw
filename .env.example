# Copy to .env and replace connector values. Values are stored in clear text.
HOST=127.0.0.1
PORT=3100

# Enterprise connector. Raw preserves function calls and tool results.
GEMINI_CLIENT=connector
GEMINI_CONNECTOR_BASE_URL=http://127.0.0.1:3999
GEMINI_CONNECTOR_ID=replace-with-connector-id
GEMINI_CONNECTOR_API_KEY=replace-with-connector-api-key
GEMINI_CONNECTOR_MODEL=gemini-2.5-pro
GEMINI_CONNECTOR_MODE=raw

# Optional DCC-compatible AI Studio mode; unused with GEMINI_CLIENT=connector.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# DCC AI logging and file rotation settings.
OPENAI_RESPONSE_LOG_ENABLED=false
AI_CLIENT_TRAFFIC_LOG_ENABLED=false
AI_RESPONSE_LOG_MAX_LENGTH=300
LOG_FILE_MAX_SIZE_MB=100
LOG_FILE_MAX_FILES=30
